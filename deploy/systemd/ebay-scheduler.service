[Unit]
Description=eBay Laptop Finder scheduler
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ebay
ExecStart=/usr/bin/php artisan schedule:work --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
